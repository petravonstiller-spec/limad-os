#!/usr/bin/env bash
# Installs LiMaD's graphical default applications for the current user.
# Flatpak is deliberately used at user scope: Bazzite/bootc keeps /usr immutable.
set -u

readonly STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/limad"
readonly STATE_FILE="${STATE_DIR}/default-flatpaks-fix43.done"
readonly LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/limad"
readonly LOG_FILE="${LOG_DIR}/default-flatpaks.log"
readonly LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/limad-default-flatpaks.lock"
readonly FLATHUB_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
readonly AERION_TITLEBAR_HELPER="${LIMAD_AERION_TITLEBAR_HELPER:-/usr/local/bin/limad-aerion-native-titlebar}"
readonly KLANG_PRESET_HELPER="${LIMAD_KLANG_PRESET_HELPER:-/usr/local/bin/limad-install-klang-preset}"

mkdir -p "$STATE_DIR" "$LOG_DIR"
[[ -e "$STATE_FILE" ]] && exit 0
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
exec >>"$LOG_FILE" 2>&1
printf '\n[%s] LiMaD default Flatpak setup started\n' "$(date -Is 2>/dev/null || date)"

if ! command -v flatpak >/dev/null 2>&1; then
  echo "flatpak command missing; will retry at next login"
  exit 1
fi

# A user remote avoids modifying the immutable system and needs no password.
if ! flatpak remotes --user --columns=name 2>/dev/null | grep -Fxq flathub; then
  flatpak remote-add --user --if-not-exists flathub "$FLATHUB_URL" || {
    echo "could not configure user Flathub remote; will retry"
    exit 1
  }
fi

installed_any_scope() {
  flatpak info --user "$1" >/dev/null 2>&1 || flatpak info --system "$1" >/dev/null 2>&1
}

install_user_app() {
  local app_id="$1"
  if installed_any_scope "$app_id"; then
    echo "already installed: $app_id"
    return 0
  fi
  echo "installing: $app_id"
  flatpak install --user --noninteractive -y flathub "$app_id"
}

# Zen changed from the historical io.github ID to its current official app ID.
# Prefer the current ID, but retain a fallback so a temporary Flathub migration
# cannot leave a fresh LiMaD installation without a browser.
ZEN_ID="app.zen_browser.zen"
if installed_any_scope "$ZEN_ID"; then
  :
elif installed_any_scope "io.github.zen_browser.zen"; then
  ZEN_ID="io.github.zen_browser.zen"
elif ! install_user_app "$ZEN_ID"; then
  ZEN_ID="io.github.zen_browser.zen"
  install_user_app "$ZEN_ID" || {
    echo "Zen Browser installation failed"
    exit 1
  }
fi

FAILED=0
if install_user_app "io.github.hkdb.Aerion"; then
  "$AERION_TITLEBAR_HELPER" || FAILED=1
else
  FAILED=1
fi
install_user_app "us.zoom.Zoom" || FAILED=1
install_user_app "app.ytmdesktop.ytmdesktop" || FAILED=1
if install_user_app "com.github.wwmm.easyeffects"; then
  "$KLANG_PRESET_HELPER" || FAILED=1
else
  FAILED=1
fi
install_user_app "io.github.kolunmi.Bazaar" || FAILED=1
if (( FAILED != 0 )); then
  echo "one or more default applications failed; will retry at next login"
  command -v notify-send >/dev/null 2>&1 && \
    notify-send -u normal "LiMaD Apps" "Zen, Aerion, Zoom, YTMDesktop, EasyEffects oder Bazaar konnten noch nicht vollständig installiert werden. LiMaD versucht es beim nächsten Login erneut." || true
  exit 1
fi

# Apply the exact requested dock order after Flatpak has exported its launchers.
if command -v gsettings >/dev/null 2>&1 && \
   gsettings list-schemas 2>/dev/null | grep -Fxq org.gnome.shell && \
   gsettings writable org.gnome.shell favorite-apps 2>/dev/null | grep -qx true; then
  FAVORITES="['${ZEN_ID}.desktop', 'io.github.hkdb.Aerion.desktop', 'de.limad.Cut.desktop', 'de.limad.Study.desktop', 'de.limad.Drop.desktop', 'de.limad.WindowsApps.desktop', 'de.limad.Updater.desktop', 'de.limad.AnycubicSlicerNext.desktop', 'us.zoom.Zoom.desktop', 'app.ytmdesktop.ytmdesktop.desktop', 'de.limad.Klang.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Console.desktop', 'org.gnome.Nautilus.desktop']"
  gsettings set org.gnome.shell favorite-apps "$FAVORITES" || true
fi

printf 'ZEN_ID=%q\n' "$ZEN_ID" > "${STATE_DIR}/default-flatpaks.env"
touch "$STATE_FILE"
command -v notify-send >/dev/null 2>&1 && \
  notify-send -u normal "LiMaD Apps bereit" "Zen Browser, Aerion, Zoom, YTMDesktop, LiMaD Klang und Bazaar sind installiert und im Dock angeordnet." || true
echo "LiMaD default Flatpak setup completed"
